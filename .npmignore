# exclude everything
/*

# only include project files
!/.npmignore
!/*.md
# exclude internal/development markdown (audit, release notes, internal docs)
/REVIEW_*.md
/RELEASE.MD
/NPM_PUBLISH.md
/CLAUDE.md
# exclude dev tooling, CI, tarballs, workspace
/scripts
/.github
/josuelmm-cordova-background-geolocation-*.tgz
/cordova-background-geolocation-plugin.code-workspace
!/plugin.xml
!/package.json
!/www
!/angular
# Only ship ng-packagr output for ./angular, not old tsc .js/.d.ts
/angular/*.js
/angular/*.d.ts
/angular/public-api.ts
/angular/ng-package.json
/angular/tsconfig.lib.json
/angular/package.json
!/angular/dist
!/android
/android/*
!/android/dependencies.gradle
!/android/common
/android/common/*
!/android/common/src
/android/common/src/test
/android/common/src/androidTest
!/android/CDVBackgroundGeolocation
/android/CDVBackgroundGeolocation/*
!/android/CDVBackgroundGeolocation/src
/android/CDVBackgroundGeolocation/src/test
!/ios
/ios/*
!/ios/common
/ios/common/BackgroundGeolocationTests
/ios/common/scripts
!/ios/CDVBackgroundGeolocation
!/LICENSE
